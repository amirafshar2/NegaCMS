<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- UI layer (ASP.NET Core MVC). Talks only to BLL services. -->
  <PropertyGroup>
    <RootNamespace>Negacom</RootNamespace>
    <AssemblyName>Negacom</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="$(EfCoreVersion)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\BE\BE.csproj" />
    <ProjectReference Include="..\DAL\DAL.csproj" />
    <ProjectReference Include="..\BLL\BLL.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The SQLite database file lives inside the project -->
    <None Update="App_Data\nega.db" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Update="wwwroot\uploads\content\**" CopyToPublishDirectory="Never" />
  </ItemGroup>
</Project>
