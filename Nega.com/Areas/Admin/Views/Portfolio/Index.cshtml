@model List<Portfolio>
@{ ViewData["Title"] = "Referenzen"; }
<div class="page-title"><div><h1>Referenzen</h1><p>Projekte im Bereich „Referenzen“ der Startseite – filterbar nach Kategorie.</p></div>
    <div class="actions"><a class="btn btn-ghost" href="/admin/portfoliocategories"><i class="far fa-folder"></i> Kategorien</a>
        <a class="btn btn-primary" href="/admin/portfolio/create"><i class="fas fa-plus"></i> Neues Projekt</a></div></div>
<div class="cards-grid">
    @foreach (var p in Model)
    {
        <div class="card item-card">
            <img class="cover" src="@p.Picture" alt="" />
            <div class="body"><span class="badge b-blue">@p.PortfolioCategory?.Name</span><b style="margin-top:8px">@p.Brand</b><p class="muted small" style="margin:4px 0 0">@p.Title</p></div>
            <div class="foot">
                @await Html.PartialAsync("_Status", (p.Status, $"/admin/portfolio/toggle/{p.Id}", "Sichtbar", "Ausgeblendet"))
                <div class="actions"><a class="btn btn-ghost btn-icon" href="/admin/portfolio/edit/@p.Id"><i class="far fa-edit"></i></a>
                    @await Html.PartialAsync("_Delete", ($"/admin/portfolio/delete/{p.Id}", $"Projekt „{p.Brand}“ löschen?"))</div>
            </div>
        </div>
    }
</div>
