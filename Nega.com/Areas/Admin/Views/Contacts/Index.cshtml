@model List<Contact>
@{ ViewData["Title"] = "Nachrichten"; var f = (string)ViewBag.Filter; }
<div class="page-title"><div><h1>Nachrichten</h1><p>Anfragen aus dem Kontaktformular der Website.</p></div></div>
<div class="card">
    <div class="toolbar"><nav class="tabs">
        <a class="@(f != "unread" ? "active" : null)" href="/admin/contacts">Alle <span class="n">@ViewBag.All</span></a>
        <a class="@(f == "unread" ? "active" : null)" href="/admin/contacts?filter=unread">Ungelesen <span class="n">@ViewBag.Unread</span></a>
    </nav></div>
    @if (!Model.Any()) { <div class="empty"><i class="far fa-envelope-open"></i><p>Keine Nachrichten.</p></div> }
    else
    {
        <div class="table-wrap"><table class="table">
            <thead><tr><th></th><th>Absender</th><th>Betreff</th><th>Eingang</th><th></th></tr></thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr class="@(c.IsRead ? null : "unread")">
                        <td style="width:40px"><i class="far @(c.IsRead ? "fa-envelope-open muted" : "fa-envelope")" style="color:@(c.IsRead ? "" : "#ff5a36")"></i></td>
                        <td><b>@c.UserName</b><br /><small class="muted">@c.Mail</small></td>
                        <td><a href="/admin/contacts/detail/@c.Id"><b>@c.Subject</b></a><div class="clip muted small">@c.Message</div></td>
                        <td class="muted" style="white-space:nowrap">@Fmt.Ago(c.Date)</td>
                        <td><div class="actions"><a class="btn btn-ghost btn-sm" href="/admin/contacts/detail/@c.Id">Öffnen</a>
                            @await Html.PartialAsync("_Delete", ($"/admin/contacts/delete/{c.Id}", "Nachricht löschen?"))</div></td>
                    </tr>
                }
            </tbody>
        </table></div>
    }
</div>
