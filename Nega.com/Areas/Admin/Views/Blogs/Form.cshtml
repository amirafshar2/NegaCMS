@model Blog
@{
    var isNew = Model.Id == 0;
    ViewData["Title"] = isNew ? "Neuer Artikel" : "Artikel bearbeiten";
}
<div class="page-title">
    <div><div class="crumbs"><a href="/admin/blogs">Blogartikel</a> / @(isNew ? "Neu" : "Bearbeiten")</div><h1>@ViewData["Title"]</h1></div>
    @if (!isNew) { <a class="btn btn-ghost" href="/blog/@Model.Id" target="_blank"><i class="far fa-eye"></i> Auf der Website ansehen</a> }
</div>
<partial name="_Errors" />
<form asp-antiforgery="true" method="post" enctype="multipart/form-data" action="@(isNew ? "/admin/blogs/create" : $"/admin/blogs/edit/{Model.Id}")">
    <div class="form-grid">
        <div class="card"><div class="card-body">
            <div class="field"><label asp-for="Title">Titel</label><input asp-for="Title" maxlength="200" required /></div>
            <div class="field"><label asp-for="Summary">Kurzbeschreibung</label><textarea asp-for="Summary" maxlength="400" rows="3" data-count="sumCount" required></textarea><div class="hint" id="sumCount"></div></div>
            <div class="field">
                <label asp-for="Content">Inhalt</label>
                <textarea asp-for="Content" class="tall" required data-count="contentCount"></textarea>
                <div class="hint"><span id="contentCount"></span> · Formatierung: Leerzeile = neuer Absatz, <code>## Überschrift</code>, <code>- Listenpunkt</code></div>
            </div>
        </div></div>
        <div class="sticky-side">
            <div class="card"><div class="card-body">
                <label class="switch"><input type="checkbox" asp-for="Status" /> Veröffentlicht</label>
                <div class="field"><label asp-for="CategoryId">Kategorie</label>
                    <select asp-for="CategoryId" asp-items="(List<SelectListItem>)ViewBag.Categories" required><option value="">– bitte wählen –</option></select></div>
                <div class="field"><label asp-for="Date">Datum</label><input asp-for="Date" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" /></div>
                <div class="form-actions">
                    <button class="btn btn-primary" type="submit"><i class="far fa-save"></i> Speichern</button>
                    <a class="btn btn-ghost" href="/admin/blogs">Abbrechen</a>
                </div>
            </div></div>
            <div class="card"><div class="card-body">@await Html.PartialAsync("_ImageField", (Model.Picture, "Titelbild", false))</div></div>
        </div>
    </div>
</form>
