@model List<Comment>
@{
    ViewData["Title"] = "Kommentare";
    var f = (string)ViewBag.Filter;
}
<div class="page-title"><div><h1>Kommentare</h1><p>Neue Kommentare von Besuchern müssen freigegeben werden, bevor sie auf der Website erscheinen.</p></div></div>
<div class="card">
    <div class="toolbar">
        <nav class="tabs">
            <a class="@(f == "all" ? "active" : null)" href="/admin/comments">Alle <span class="n">@ViewBag.All</span></a>
            <a class="@(f == "pending" ? "active" : null)" href="/admin/comments?filter=pending">Wartend <span class="n">@ViewBag.Pending</span></a>
            <a class="@(f == "approved" ? "active" : null)" href="/admin/comments?filter=approved">Freigegeben</a>
        </nav>
    </div>
    @if (!Model.Any()) { <div class="empty"><i class="far fa-comments"></i><p>Keine Kommentare in dieser Ansicht.</p></div> }
    else
    {
        <div class="table-wrap"><table class="table">
            <thead><tr><th>Autor</th><th>Kommentar</th><th>Artikel</th><th>Antworten</th><th>Datum</th><th>Status</th><th></th></tr></thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr class="@(c.Status ? null : "unread")">
                        <td><div class="cell-main" style="min-width:160px"><span class="avatar">@ContentHelper.Initials(c.AuthorName)</span><div><b>@c.AuthorName</b><small>@c.Email</small></div></div></td>
                        <td><div class="clip" style="max-width:300px">@c.Content</div></td>
                        <td><a class="clip" style="max-width:200px;display:block" href="/blog/@c.BlogId" target="_blank">@c.Blog?.Title</a></td>
                        <td>@c.Replies.Count</td>
                        <td class="muted">@Fmt.Ago(c.Date)</td>
                        <td>@await Html.PartialAsync("_Status", (c.Status, $"/admin/comments/toggle/{c.Id}?back={f}", "Freigegeben", "Wartet"))</td>
                        <td><div class="actions">
                            <a class="btn btn-ghost btn-sm" href="/admin/comments/detail/@c.Id"><i class="fas fa-reply"></i> Antworten</a>
                            @await Html.PartialAsync("_Delete", ($"/admin/comments/delete/{c.Id}", "Kommentar inkl. Antworten löschen?"))
                        </div></td>
                    </tr>
                }
            </tbody>
        </table></div>
    }
</div>
