@model User
@{
    ViewData["Title"] = "Mein Profil";
    var roles = (IList<string>)ViewBag.Roles;
    var blogs = (List<Blog>)ViewBag.MyBlogs;
}
<div class="card" style="margin-bottom:20px">
    <div class="profile-head">
        <img src="@Model.Picture" alt="" width="96" height="96" />
        <div>
            <h1 style="font-size:1.5rem;margin:0">@Model.FullName</h1>
            <p class="muted" style="margin:2px 0 8px">@Model.JobTitle · <code>@Model.UserName</code></p>
            @foreach (var r in roles) { <span class="badge b-red" style="margin-inline-end:4px">@r</span> }
            <span class="badge b-gray">Mitglied seit @Model.RegisterDate.ToString("MM/yyyy")</span>
        </div>
    </div>
</div>
<div class="row cols-main">
    <div class="card">
        <div class="card-head"><h3><i class="far fa-user"></i> Profil bearbeiten</h3></div>
        <form asp-antiforgery="true" class="card-body" method="post" enctype="multipart/form-data" action="/admin/profile/update">
            <div class="field-row">
                <div class="field"><label for="pn">Vorname</label><input id="pn" name="name" value="@Model.Name" required /></div>
                <div class="field"><label for="pf">Nachname</label><input id="pf" name="family" value="@Model.Family" /></div>
            </div>
            <div class="field-row">
                <div class="field"><label for="pj">Position</label><input id="pj" name="jobTitle" value="@Model.JobTitle" /></div>
                <div class="field"><label for="pp">Telefon</label><input id="pp" name="phoneNumber" value="@Model.PhoneNumber" /></div>
            </div>
            <div class="field"><label for="pa">Über mich</label><textarea id="pa" name="about" rows="3">@Model.About</textarea><div class="hint">Wird unter Ihren Blogartikeln angezeigt.</div></div>
            <div class="field-row">
                <div class="field"><label for="pl">LinkedIn</label><input id="pl" name="linkedIn" value="@Model.LinkedIn" type="url" /></div>
                <div class="field"><label for="pi">Instagram</label><input id="pi" name="instagram" value="@Model.Instagram" type="url" /></div>
            </div>
            @await Html.PartialAsync("_ImageField", (Model.Picture, "Profilbild", true))
            <button class="btn btn-primary" type="submit"><i class="far fa-save"></i> Profil speichern</button>
        </form>
    </div>
    <div style="display:grid;gap:20px;align-content:start">
        <div class="card">
            <div class="card-head"><h3><i class="fas fa-lock"></i> Passwort ändern</h3></div>
            <form asp-antiforgery="true" class="card-body" method="post" action="/admin/profile/password">
                @if ((bool)ViewBag.DemoMode && Model.IsDemo) { <div class="alert alert-info small"><i class="fas fa-info-circle"></i><span>Im Demo-Modus deaktiviert.</span></div> }
                <div class="field"><label for="c1">Aktuelles Passwort</label><input id="c1" name="Current" type="password" autocomplete="current-password" /></div>
                <div class="field"><label for="c2">Neues Passwort</label><input id="c2" name="New" type="password" autocomplete="new-password" /></div>
                <div class="field"><label for="c3">Wiederholen</label><input id="c3" name="Confirm" type="password" autocomplete="new-password" /></div>
                <button class="btn btn-ghost" type="submit" disabled="@((bool)ViewBag.DemoMode && Model.IsDemo)">Passwort ändern</button>
            </form>
        </div>
        <div class="card">
            <div class="card-head"><h3><i class="far fa-newspaper"></i> Meine Artikel (@blogs.Count)</h3></div>
            <ul class="feed">
                @foreach (var b in blogs.Take(6)) { <li><div><a href="/admin/blogs/edit/@b.Id"><b>@b.Title</b></a><p>@Fmt.Num(b.ViewCount) Aufrufe · @b.Date.ToString("dd.MM.yyyy")</p></div></li> }
                @if (!blogs.Any()) { <li class="muted">Noch keine Artikel.</li> }
            </ul>
        </div>
    </div>
</div>
