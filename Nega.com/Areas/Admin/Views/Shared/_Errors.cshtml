@{ var errors = ViewContext.ViewData.ModelState.Values.SelectMany(v => v.Errors).Select(e => e.ErrorMessage).Where(e => !string.IsNullOrEmpty(e)).Distinct().ToList(); }
@if (errors.Any())
{
    <div class="alert alert-err" role="alert"><i class="fas fa-exclamation-circle"></i>
        <div><b>Bitte prüfen Sie Ihre Eingaben:</b><ul>@foreach (var e in errors) { <li>@e</li> }</ul></div>
    </div>
}
