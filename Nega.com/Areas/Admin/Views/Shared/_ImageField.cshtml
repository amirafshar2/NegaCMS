@model (string Url, string Label, bool Round)
<div class="field image-field @(Model.Round ? "round" : null)">
    <span class="label">@Model.Label</span>
    <div class="preview" data-preview>
        @if (!string.IsNullOrEmpty(Model.Url)) { <img src="@Model.Url" alt="" /> } else { <span><i class="far fa-image"></i> Kein Bild</span> }
    </div>
    <input type="file" name="ImageFile" accept="image/jpeg,image/png,image/webp,image/gif" data-image-input />
    <div class="hint">JPG, PNG, WEBP oder GIF · max. 2 MB</div>
</div>
