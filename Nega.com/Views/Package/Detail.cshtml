@model Package
@{
    ViewData["Title"] = $"Paket {Model.Name}";
    ViewData["Description"] = Model.Content;
    var others = (List<Package>)ViewBag.Others;
}
<div class="page-head">
    <div class="container">
        <span class="eyebrow">Paket</span>
        <h1>@Model.Name – @Model.Title</h1>
        <nav class="breadcrumb" aria-label="Brotkrumen"><a href="/">Start</a><span>/</span><a href="/#pricing">Preise</a><span>/</span><span>@Model.Name</span></nav>
    </div>
</div>
<div class="container pkg-hero">
    <div>
        <img src="@Model.Picture" alt="" width="1200" height="750" />
        <div class="prose" style="margin-top:32px">
            <h2>Das ist enthalten</h2>
            <p>@Model.Content</p>
            <ul>@foreach (var f in Model.FeatureList) { <li>@f</li> }</ul>
            <h2>So läuft es ab</h2>
            <p>Nach einem kostenlosen Erstgespräch erhalten Sie ein Konzept mit Zeitplan. Wir setzen Ihr Projekt in rund @Model.DeliveryDays Tagen um und stimmen jeden Schritt mit Ihnen ab. Nach dem Launch zeigen wir Ihnen, wie Sie Inhalte im Admin-Panel selbst pflegen.</p>
        </div>
    </div>
    <aside class="card pkg-box @(Model.IsPopular ? "price popular" : null)">
        @if (Model.IsPopular) { <span class="team-badge" style="margin:0 0 10px;display:inline-block">Beliebtestes Paket</span> }
        <h3 style="font-size:1.4rem">@Model.Name</h3>
        <div class="amount" style="font-size:2.4rem;font-weight:900">@Fmt.Price(Model.Price, Model.PriceUnit)</div>
        <p class="muted">einmalig, zzgl. MwSt.</p>
        <ul class="checks">
            <li><i class="far fa-clock"></i> ca. @Model.DeliveryDays Tage Umsetzung</li>
            <li><i class="fas fa-shield-alt"></i> SSL & DSGVO-konform</li>
            <li><i class="fas fa-headset"></i> Persönlicher Support</li>
        </ul>
        <a class="btn btn-primary btn-block" href="/#contact"><i class="far fa-paper-plane"></i> Paket anfragen</a>
    </aside>
</div>
@if (others?.Any() == true)
{
    <section class="section-alt" style="padding-block:64px">
        <div class="container">
            <h2 style="text-align:center;margin-bottom:32px">Weitere Pakete</h2>
            <div class="grid grid-2" style="max-width:820px;margin:0 auto">
                @foreach (var p in others)
                {
                    <a class="card price" href="/package/detail/@p.Id"><h3>@p.Name</h3><span class="sub">@p.Title</span><div class="amount" style="font-size:2rem">@Fmt.Price(p.Price, p.PriceUnit)</div></a>
                }
            </div>
        </div>
    </section>
}
