@inject BLL.Abstract.IOurContactService SettingsService
@inject Microsoft.Extensions.Configuration.IConfiguration Config
@{
    var s = SettingsService.Get();
    var privacyUrl = Config["Legal:PrivacyUrl"] is { Length: > 0 } pu ? pu : "/datenschutz";
    var imprintUrl = Config["Legal:ImprintUrl"] is { Length: > 0 } iu ? iu : "/impressum";
    var path = Context.Request.Path.Value ?? "/";
    string Active(string p) => (p == "/" ? path == "/" : path.StartsWith(p)) ? "active" : null;
}
<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] is string t ? $"{t} – {s.CompanyName}" : $"{s.CompanyName} – {s.Slogan}")</title>
    <meta name="description" content="@(ViewData["Description"] ?? s.HeroText)" />
    <meta name="theme-color" content="#0b0c10" />
    <link rel="icon" href="~/img/brand/favicon.png" type="image/png" />
    <link rel="stylesheet" href="~/vendor/fontawesome/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="demo-bar">
        <i class="fas fa-flask"></i> Demo-Projekt<span class="long"> (ASP.NET Core · 3-Schichten-Architektur · SQLite)</span> –
        <a href="/admin">Admin-Bereich ohne Anmeldung ansehen</a>
    </div>

    <header class="site-header">
        <div class="container nav">
            <a class="logo" href="/" aria-label="@s.CompanyName – Startseite"><img src="~/img/brand/logo-light.png" alt="NEGA" width="106" height="40" /></a>
            <ul class="nav-links" id="navLinks">
                <li><a class="@Active("/")" href="/">Start</a></li>
                <li><a href="/#services">Leistungen</a></li>
                <li><a href="/#about">Über uns</a></li>
                <li><a href="/#work">Projekte</a></li>
                <li><a class="@Active("/package")" href="/#pricing">Preise</a></li>
                <li><a class="@Active("/blog")" href="/blog">Blog</a></li>
                <li><a href="/#contact">Kontakt</a></li>
            </ul>
            <div class="nav-actions">
                <a class="btn btn-primary btn-sm" href="/admin"><i class="fas fa-sliders-h"></i> Admin-Demo</a>
                <button class="nav-toggle" type="button" aria-label="Menü öffnen" aria-controls="navLinks" aria-expanded="false"><i class="fas fa-bars"></i></button>
            </div>
        </div>
    </header>

    <main id="main">
        @if (TempData["ok"] is string ok)
        {
            <div class="container" style="margin-top:24px"><div class="alert alert-ok" role="status"><i class="fas fa-check-circle"></i><span>@ok</span></div></div>
        }
        @if (TempData["err"] is string err)
        {
            <div class="container" style="margin-top:24px"><div class="alert alert-err" role="alert"><i class="fas fa-exclamation-circle"></i><span>@err</span></div></div>
        }
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container">
            <div class="footer-grid">
                <div>
                    <img src="~/img/brand/logo-light.png" alt="NEGA" style="height:42px;width:auto;margin-bottom:16px" />
                    <p class="muted" style="max-width:320px">@s.HeroText</p>
                    <div class="socials">
                        @if (!string.IsNullOrEmpty(s.Instagram)) { <a href="@s.Instagram" target="_blank" rel="noopener" aria-label="Instagram"><i class="fab fa-instagram"></i></a> }
                        @if (!string.IsNullOrEmpty(s.LinkedIn)) { <a href="@s.LinkedIn" target="_blank" rel="noopener" aria-label="LinkedIn"><i class="fab fa-linkedin-in"></i></a> }
                        @if (!string.IsNullOrEmpty(s.Github)) { <a href="@s.Github" target="_blank" rel="noopener" aria-label="GitHub"><i class="fab fa-github"></i></a> }
                        @if (!string.IsNullOrEmpty(s.Telegram)) { <a href="@s.Telegram" target="_blank" rel="noopener" aria-label="Telegram"><i class="fab fa-telegram-plane"></i></a> }
                    </div>
                </div>
                <div>
                    <h4>Navigation</h4>
                    <ul>
                        <li><a href="/#services">Leistungen</a></li>
                        <li><a href="/#work">Projekte</a></li>
                        <li><a href="/#pricing">Preise</a></li>
                        <li><a href="/blog">Blog</a></li>
                    </ul>
                </div>
                <div>
                    <h4>Kontakt</h4>
                    <ul>
                        <li><i class="fas fa-phone-alt" style="color:var(--accent-2);margin-inline-end:.5em"></i>@s.PhoneNumber</li>
                        <li><i class="far fa-envelope" style="color:var(--accent-2);margin-inline-end:.5em"></i>@s.Email</li>
                        <li><i class="fas fa-map-marker-alt" style="color:var(--accent-2);margin-inline-end:.5em"></i>@s.Address</li>
                    </ul>
                </div>
                <div>
                    <h4>Rechtliches</h4>
                    <ul>
                        <li><a href="@imprintUrl">Impressum</a></li>
                        <li><a href="@privacyUrl">Datenschutz</a></li>
                        <li><a href="/admin">Admin-Demo</a></li>
                    </ul>
                </div>
            </div>
            <div class="footer-bottom">
                <span>© @DateTime.Now.Year @s.CompanyName · Demo-Website</span>
                <span>Entwickelt von <a href="https://github.com/amirafshar2" target="_blank" rel="noopener" style="color:#fff">Amir Reza Afshar</a> mit ASP.NET Core 8</span>
            </div>
        </div>
    </footer>

    <button class="to-top" type="button" aria-label="Nach oben"><i class="fas fa-arrow-up"></i></button>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
