@model BlogListViewModel
@{
    ViewData["Title"] = Model.ActiveCategory?.Name ?? "Blog";
    ViewData["Description"] = "Artikel zu Webentwicklung, Design, SEO und Online-Marketing.";
    var b = Model.Blogs;
    string PageUrl(int p) => $"/blog?page={p}" + (Model.CategoryId != null ? $"&category={Model.CategoryId}" : "") + (!string.IsNullOrEmpty(Model.Search) ? $"&q={Uri.EscapeDataString(Model.Search)}" : "");
}
<div class="page-head">
    <div class="container">
        <span class="eyebrow">Blog</span>
        <h1>@(Model.ActiveCategory?.Name ?? (string.IsNullOrEmpty(Model.Search) ? "Wissen & Tipps" : $"Suche: „{Model.Search}“"))</h1>
        <nav class="breadcrumb" aria-label="Brotkrumen"><a href="/">Start</a><span>/</span><a href="/blog">Blog</a>@if (Model.ActiveCategory != null) {<span>/</span><span>@Model.ActiveCategory.Name</span>}</nav>
    </div>
</div>
<div class="container blog-layout">
    <div>
        @if (!b.Items.Any())
        {
            <div class="card empty"><i class="far fa-folder-open"></i><h3>Keine Artikel gefunden</h3><p>Versuchen Sie einen anderen Suchbegriff oder eine andere Kategorie.</p><a class="btn btn-ghost" href="/blog">Alle Artikel</a></div>
        }
        else
        {
            <p class="muted" style="margin-bottom:20px">@b.Total @(b.Total == 1 ? "Artikel" : "Artikel") gefunden</p>
            <div class="grid grid-2">
                @foreach (var p in b.Items) { <partial name="_PostCard" model="p" /> }
            </div>
            @if (b.TotalPages > 1)
            {
                <nav class="pagination" aria-label="Seiten">
                    @if (b.Page > 1) { <a href="@PageUrl(b.Page - 1)" aria-label="Vorherige Seite"><i class="fas fa-chevron-left"></i></a> }
                    @for (int i = 1; i <= b.TotalPages; i++)
                    {
                        if (i == b.Page) { <span class="current" aria-current="page">@i</span> } else { <a href="@PageUrl(i)">@i</a> }
                    }
                    @if (b.Page < b.TotalPages) { <a href="@PageUrl(b.Page + 1)" aria-label="Nächste Seite"><i class="fas fa-chevron-right"></i></a> }
                </nav>
            }
        }
    </div>
    @{ var side = (Model.Categories, Model.Popular, "Beliebte Artikel", Model.CategoryId, Model.Search); }
    <partial name="_Sidebar" model="side" />
</div>
