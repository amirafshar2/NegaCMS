@model ErrorViewModel
@{
    var (title, text) = Model.StatusCode switch
    {
        404 => ("Seite nicht gefunden", "Die gesuchte Seite existiert nicht oder wurde verschoben."),
        400 => ("Ungültige Anfrage", "Das Formular ist abgelaufen oder unvollständig. Bitte laden Sie die Seite neu und versuchen Sie es erneut."),
        403 => ("Kein Zugriff", "Sie haben keine Berechtigung für diese Seite."),
        _ => ("Etwas ist schiefgelaufen", "Bitte versuchen Sie es in einem Moment erneut."),
    };
    ViewData["Title"] = title;
}
<div class="container error-page">
    <div class="code">@Model.StatusCode</div>
    <h1>@title</h1>
    <p class="muted">@text</p>
    <a class="btn btn-primary" href="/"><i class="fas fa-home"></i> Zur Startseite</a>
</div>
